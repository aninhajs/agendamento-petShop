// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  telefone  String?
  password  String
  role      String   @default("cliente")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets         Pet[]
  appointments Appointment[]

  @@map("Users")
}

model Pet {
  id        Int      @id @default(autoincrement())
  name      String
  raca      String
  idade     Int
  porte     String?
  peso      Float?
  alergias  String?
  observacoes String?
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  appointmentPets AppointmentPet[]

  @@map("Pets")
}

model Service {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  preco     Decimal  @db.Decimal(10, 2)
  duracao   Int
  tipo      String   @default("normal")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointmentServices AppointmentService[]

  @@map("Services")
}

model AvailableTime {
  id          Int      @id @default(autoincrement())
  diaSemana   Int
  horaInicio  String
  horaFim     String
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("AvailableTimes")
}

model Appointment {
  id          Int      @id @default(autoincrement())
  data        DateTime @db.Date
  hora        String
  status      String   @default("pendente")
  observacoes String?
  bairro      String?
  taxaBairro  Decimal? @db.Decimal(10, 2)
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id])
  appointmentPets     AppointmentPet[]
  appointmentServices AppointmentService[]

  @@map("Appointments")
}

model AppointmentPet {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  petId         Int
  createdAt     DateTime    @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  pet         Pet         @relation(fields: [petId], references: [id])

  @@unique([appointmentId, petId])
  @@map("AppointmentPets")
}

model AppointmentService {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  serviceId     Int
  preco         Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@unique([appointmentId, serviceId])
  @@map("AppointmentServices")
}

model NeighborhoodRate {
  id        Int      @id @default(autoincrement())
  bairro    String   @unique
  taxa      Decimal  @db.Decimal(10, 2)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("NeighborhoodRates")
}
