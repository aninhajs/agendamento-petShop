PORT=3001

# JWT Secret
JWT_SECRET=segredo_super

# OpenAI API Key para o Chatbot
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sua-chave-aqui

# Twilio para WhatsApp/SMS
# 1. Crie uma conta em: https://www.twilio.com/console
# 2. Copie Account SID e Auth Token do dashboard
# 3. Para WhatsApp, use o número de teste fornecido pelo Twilio
# Custo: ~$0.005 por mensagem (tier gratuito: $15 de crédito)
# IMPORTANTE: Deixe comentado ou vazio se não quiser usar Twilio (o sistema funcionará apenas com email)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=seu_auth_token_aqui
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Email (Gmail ou outro provedor SMTP)
# Para Gmail:
# 1. Acesse: https://myaccount.google.com/security
# 2. Ative "Verificação em duas etapas"
# 3. Vá em "Senhas de app" e crie uma senha para "Email"
# 4. Use essa senha abaixo (NÃO use sua senha normal!)
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_aqui
EMAIL_FROM_NAME=Pet Shop

# Prisma Database URLs
# Para desenvolvimento local com Supabase
DATABASE_URL="postgresql://postgres.dmekgfjaicrfkjwrjipe:SOScatastrofe@aws-1-us-east-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.dmekgfjaicrfkjwrjipe:SOScatastrofe@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

